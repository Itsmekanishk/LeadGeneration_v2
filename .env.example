[TEMPLATE]
# ============================================================================
# LocalLead Intelligence — Environment Configuration Template
# ============================================================================
# HOW TO USE
#   1. Copy this file:            cp .env.example .env
#   2. Fill in the values marked YOUR_API_KEY_HERE (or leave mock mode on).
#   3. NEVER commit the real .env to version control. It is gitignored.
#
# OUT OF THE BOX: with the defaults below, the entire stack runs in MOCK mode
# (deterministic sample data, no API keys, no network calls) — perfect for
# development, demos and CI. Switch to real data when ready (see "Provider"
# section and README.md → "Enabling real data").
#
# OPEN-SOURCE STACK: geocoding uses OpenStreetMap (Nominatim) — free, keyless,
# and replaces every Google Maps endpoint. Disposable-email detection uses
# Disify (free, keyless). See the Nominatim / Disify sections below.
# ============================================================================

# --- Core ---------------------------------------------------------------------
# development | staging | production. In production the app enforces HSTS and
# refuses known default secrets.
APP_ENV=development

# Used to sign JWTs and derive encryption keys. MUST be changed for production.
# Generate a strong value with:  openssl rand -hex 32
SECRET_KEY=change-me-please-generate-a-long-random-value-min-32-bytes

# Optional standalone Fernet key (urlsafe base64, 32 bytes) for encrypting
# provider keys at rest. Leave empty to derive it from SECRET_KEY.
ENCRYPTION_KEY=

# Browser origin of the frontend (used for CORS allow-listing)
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated list of allowed CORS origins. In production, replace with
# your real domain(s), e.g. https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Datastores -----------------------------------------------------------------
# Postgres for production; the app also supports sqlite for quick local dev.
DATABASE_URL=postgresql+psycopg2://locallead:locallead@localhost:5432/locallead
REDIS_URL=redis://localhost:6379/0

# --- Provider -------------------------------------------------------------------
# Default business-data provider:
#   geoapify  → Geoapify Places API (High-accuracy, 3,000 free req/day).
#   nominatim → OpenStreetMap (Nominatim). FREE & OPEN-SOURCE — NO API KEY NEEDED.
#   google    → Google Places API (New). Requires GOOGLE_MAPS_API_KEY.
#   serper    → Serper (google.serper.dev). Requires SERPER_API_KEY.
#   mock      → offline sample data.
BUSINESS_PROVIDER=nominatim

# Fallback chain when a provider hits rate limits or is unavailable:
PROVIDER_FALLBACK_CHAIN=auto

# Geoapify Places API key (https://www.geoapify.com — 3,000 free requests/day):
GEOAPIFY_API_KEY=

# Google Places API (New) key. When ready to invest, add your key here
# and set BUSINESS_PROVIDER=google:
GOOGLE_MAPS_API_KEY=

# Serper.dev API key (optional alternative):
SERPER_API_KEY=

# When false, startup continues cleanly even if commercial keys are absent:
PROVIDER_STRICT_CONFIG=false

# Estimated USD cost per billable call — used by the /admin usage dashboard.
GOOGLE_PLACES_TEXT_SEARCH_COST_PER_CALL=0.032
GOOGLE_PLACES_DETAILS_COST_PER_CALL=0.017

# --- OpenStreetMap / Nominatim (open-source geocoding) -----------------------------
# Replaces all Google Maps endpoints. Free for reasonable use under the OSM usage policy.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=LocalLeadIntelligence/1.0 (+https://github.com/locallead-intel; contact@localleadintel.org)
ENABLE_NOMINATIM_GEOCODE=true

# --- Disify (disposable-email detection, free & keyless) -----------------------------
# Website-extracted emails are checked against disify.com; disposable
# addresses (mailinator & co) are downgraded to LOW confidence.
ENABLE_DISIFY_CHECKS=true

# --- Standalone leadgen engine (leadgen/ CLI — all optional) -----------------------
# The engine degrades gracefully without any keys: SiteIntel falls back to a
# polite homepage fetch, phone normalization falls back to the phonenumbers
# library, and Disify/Nominatim/Open-Meteo are keyless.
# APIFY_TOKEN=                    # SiteIntel Apify actor (https://apify.com)
# NUMVERIFY_API_KEY=              # apilayer.net phone validation
# APILAYER_API_KEY=              # unified suite key (apilayer.com) — powers
#                                # mailboxlayer email validation AND falls back
#                                # for Numverify phone validation. One key, many
#                                # products. Free tier: 250 req/mo, http-only.
# MAILBOXLAYER_CHECK_HIGH_CONFIDENCE=false  # also verify business-domain emails
# NUMVERIFY_HTTPS=false           # true only on paid Numverify plans (TLS)
# SITEINTEL_ACTOR=delightful_unicorn~siteintel-domain-api
# LEADGEN_USER_AGENT=leadgen-engine/1.0 (open-source lead generation; https://your-project-url)
# LEADGEN_DB_PATH=leadgen.db      # SQLite store
# LEADGEN_OUTPUT_DIR=output       # leads.json / leads.csv land here
# LEADGEN_TIMEOUT_SECONDS=15
# LEADGEN_REQUEST_DELAY_SECONDS=1 # politeness pause between businesses

# --- Search limits ----------------------------------------------------------------
# Hard cap per search job. User requests above this are clamped server-side.
MAX_RESULTS=60
DEFAULT_RADIUS_M=3000
DEFAULT_COUNTRY=in
DEFAULT_LANGUAGE=en

# --- Website crawler (contact enrichment) ------------------------------------------
ENABLE_WEBSITE_CRAWLING=true    # set false to skip website scanning entirely
MAX_PAGES_PER_DOMAIN=5
CRAWL_TIMEOUT=12                # seconds per page
CRAWL_CONCURRENCY=4             # concurrent requests within one domain
CRAWL_JOB_CONCURRENCY=4         # businesses scanned in parallel per job
CRAWL_RATE_LIMIT_PER_DOMAIN_PER_SEC=0.5   # >= 2s between hits on same domain
CRAWL_MAX_CONTENT_BYTES=2000000
CRAWL_USER_AGENT=LocalLeadBot/1.0 (+https://example.com/locallead-bot; compliant contact-intelligence crawler)
RESPECT_ROBOTS_TXT=true
SSRF_PROTECTION=true            # block private/internal/metadata IPs. KEEP true IN PRODUCTION.
# Optional comma-separated hostnames exempt from SSRF blocking (test rigs only)
SSRF_ALLOWED_HOSTS=

# --- Rate limiting (per user) -------------------------------------------------------
RATE_LIMIT_SEARCH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120

# --- Celery worker -------------------------------------------------------------------
CELERY_TASK_SOFT_TIME_LIMIT=900
CELERY_TASK_TIME_LIMIT=960
# Number of concurrent tasks per worker container (docker-compose worker service)
CELERY_CONCURRENCY=2

# --- Exports / storage ----------------------------------------------------------------
PDF_STORAGE_PATH=./data/reports
EXPORT_MAX_ROWS=5000

# --- Email (password-reset links) -------------------------------------------------------
# Required if you want "forgot password" to actually send mail. Optional otherwise.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=YOUR_EMAIL_PASSWORD_HERE
SMTP_FROM=LocalLead <no-reply@example.com>
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Auth token lifetimes -----------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Supabase Auth (Gmail / Google OAuth) ------------------------------------
# Supabase project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://demo-leadgen.supabase.co
SUPABASE_URL=https://demo-leadgen.supabase.co

# Supabase Anonymous / Public API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.demo-anon-key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.demo-anon-key

# Optional: Supabase JWT Secret (for offline HS256 verification)
SUPABASE_JWT_SECRET=

# --- Frontend -------------------------------------------------------------------------------
# Empty → the Next.js app proxies /backend/* to the API (recommended; keep empty
# when running behind the provided nginx). Set explicitly ONLY when the browser
# talks to the API host directly, e.g. http://api.yourdomain.com
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=LocalLead Intelligence

# --- Ports (docker-compose) -------------------------------------------------------------------
HTTP_PORT=8080          # nginx entrypoint (web app)
HTTPS_PORT=8443         # nginx TLS entrypoint
API_PORT=8000           # FastAPI (direct)
POSTGRES_PORT=5432
REDIS_PORT=6379
